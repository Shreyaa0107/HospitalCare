<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basic Statistics"
            android:textColor="#123B5D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HospitalCare overview"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL PATIENTS"
            android:textColor="#1769AA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtStatsPatients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/action_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL DOCTORS"
            android:textColor="#1769AA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtStatsDoctors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/action_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL DEPARTMENTS"
            android:textColor="#1769AA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtStatsDepartments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/action_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LATEST TOKEN"
            android:textColor="#1769AA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtStatsToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/action_card" />

    </LinearLayout>

</ScrollView>