<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Department"
        android:textColor="#123B5D"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the department you want to visit"
        android:textColor="#667085"
        android:textSize="15sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="28dp" />

    <!-- General Medicine -->
    <LinearLayout
        android:id="@+id/departmentGeneral"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/action_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🩺"
            android:textSize="25sp"
            android:background="@drawable/circle_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="General Medicine"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#78909C"
            android:textSize="28sp" />

    </LinearLayout>


    <!-- Dental -->
    <LinearLayout
        android:id="@+id/departmentDental"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/action_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🦷"
            android:textSize="25sp"
            android:background="@drawable/circle_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dental"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#78909C"
            android:textSize="28sp" />

    </LinearLayout>


    <!-- Orthopedic -->
    <LinearLayout
        android:id="@+id/departmentOrthopedic"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/action_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🦴"
            android:textSize="25sp"
            android:background="@drawable/circle_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Orthopedic"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#78909C"
            android:textSize="28sp" />

    </LinearLayout>


    <!-- Cardiology -->
    <LinearLayout
        android:id="@+id/departmentCardiology"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/action_card"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="24sp"
            android:background="@drawable/circle_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cardiology"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#78909C"
            android:textSize="28sp" />

    </LinearLayout>

</LinearLayout>