<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue Management"
            android:textColor="#123B5D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitor the current hospital queue"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- CURRENT TOKEN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/action_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT PATIENT TOKEN"
                android:textColor="#1769AA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminCurrentToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#172B4D"
                android:textSize="38sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- QUEUE INFORMATION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue Information"
            android:textColor="#172B4D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/action_card">

            <TextView
                android:id="@+id/txtAdminNowServing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Now Serving: --"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminPeopleWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1769AA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/txtAdminQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Queue Status"
                android:textColor="#667085"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- APPOINTMENT DETAILS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appointment Details"
            android:textColor="#172B4D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/action_card">

            <TextView
                android:id="@+id/txtAdminDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Department: --"
                android:textColor="#172B4D"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtAdminDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doctor: --"
                android:textColor="#172B4D"
                android:textSize="15sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>