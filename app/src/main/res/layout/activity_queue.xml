<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue Status"
            android:textColor="#123B5D"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track your appointment and queue position."
            android:textColor="#667085"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtToken"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="center"
            android:text="TOKEN 01"
            android:textColor="#123B5D"
            android:textSize="32sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtDepartment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Department: --"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtDoctor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Doctor: --"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Date: --"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Time: --"
            android:textColor="#172B4D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtNowServing"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Now Serving: 01"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtPeopleAhead"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="People Ahead: 0"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <TextView
            android:id="@+id/txtQueueStatus"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Status: Waiting"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/action_card" />

        <Button
            android:id="@+id/btnRefreshQueue"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Refresh Queue"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>